<mxfile host="drawio"><diagram name="06-thuat-toan-de-xuat" id="06-thuat-toan-de-xuat"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Bắt đầu" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="170" y="0" width="160" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Hồ sơ: vai trò, khu vực,&lt;br&gt;số năm, kỹ năng hiện có" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="120" y="70" width="260" height="50" as="geometry"/></mxCell><mxCell id="c5" value="y₀ = f(hồ sơ)&lt;br&gt;khoảng = y₀ × [P10, P90] tỉ lệ sai số valid" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="100" y="150" width="300" height="60" as="geometry"/></mxCell><mxCell id="c6" value="Ứng viên = kỹ năng xuất hiện ở ≥ 3% tin&lt;br&gt;cùng vai trò và người dùng chưa có" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="100" y="240" width="300" height="60" as="geometry"/></mxCell><mxCell id="c7" value="Còn kỹ năng&lt;br&gt;ứng viên k?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="330" width="200" height="90" as="geometry"/></mxCell><mxCell id="c8" value="Δk = f(hồ sơ + k) − y₀&lt;br&gt;tỉ lệ nhu cầu của k" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=1